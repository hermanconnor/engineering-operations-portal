# ==============================================================================
# Monorepo Root - Master .gitignore
# Targets: FastAPI (Python/uv/Docker) + React/Next.js (Node/Vite)
# ==============================================================================

# ------------------------------------------------------------------------------
# System & Editor Garbage (Global)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
*.swp
*.bak
*~
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
tempCodeRunnerFile*

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.secret

# ------------------------------------------------------------------------------
# Backend: Python & uv Package Manager
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
**/__pycache__/
*.py[codz]
*$py.class
*.so

# Environments & Tooling caches
**/.venv/
**/env/
**/venv/
**/.uv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.pytype/
**/.coverage
**/htmlcov/
**/.ipynb_checkpoints/

# Distribution / Packaging / Builds
**/build/
**/dist/
**/*.egg-info/
**/.eggs/

# SQLite databases (if used locally)
*.db
*.sqlite3
*.sqlite3-journal

# uv.lock is explicitly ALLOWED for reproducibility (as per your snippet)
!**/uv.lock

# ------------------------------------------------------------------------------
# Frontend: Node, React (Vite), and Next.js
# ------------------------------------------------------------------------------
# Dependency directories
**/node_modules/
**/.pnp/
.pnp.js

# Vite / React build outputs
**/frontend/dist/
**/frontend/out/

# Next.js build outputs & caches
**/frontend/.next/
**/frontend/next-env.d.ts

# Testing & Coverage
**/frontend/coverage/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
Bun.lockb

# TypeScript build info
*.tsbuildinfo

# Vercel deployment metadata (if applicable)
**/.vercel/

# ------------------------------------------------------------------------------
# Docker & Containers
# ------------------------------------------------------------------------------
# Ignore local data volumes populated by Docker containers (e.g., Postgres, Redis)
**/docker_data/
**/*-data/
**/.docker-data/

# Avoid committing local docker overrides if they contain environment variants
# docker-compose.override.yml